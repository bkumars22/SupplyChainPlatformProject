		<!-- Spring AOP — required for @Aspect audit logging.
		     spring-boot-starter-aop doesn't exist as of Spring Boot 4.0.4
		     (404 on Maven Central, absent from the spring-boot-dependencies
		     BOM) — proxy-based AOP itself is already in core Spring
		     (transitively pulled in by every starter), aspectjweaver is the
		     one piece actually needed for parsing @Aspect pointcut
		     expressions, and it's still BOM-managed. -->
		<dependency>
			<groupId>org.aspectj</groupId>
			<artifactId>aspectjweaver</artifactId>
		</dependency>

