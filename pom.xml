	<properties>
		<java.version>17</java.version>
		<!-- Sonar Configuration (CI-only; configure via -Dsonar.host.url or CI profile) -->
		<!-- sonar.host.url configured via environment -->
		<sonar.projectKey>MTCM</sonar.projectKey>
		<sonar.projectName>MTCM</sonar.projectName>
		<sonar.projectVersion>1.0-SNAPSHOT</sonar.projectVersion>
		<sonar.java.source>17</sonar.java.source>
		<sonar.java.target>17</sonar.java.target>
		<sonar.jvmArgs>-Xmx3g</sonar.jvmArgs>
		<!-- Source and Test Configuration -->
		<sonar.sources>src/main</sonar.sources>
		<sonar.tests>src/test</sonar.tests>
		<!-- Coverage Configuration -->
		<sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
		<sonar.dynamicAnalysis>reuseReports</sonar.dynamicAnalysis>
		<sonar.java.coveragePlugin>jacoco</sonar.java.coveragePlugin>
		<!-- Exclusions for non-source files -->
		<sonar.exclusions>
			**/target/**,
			**/generated/**,
			**/schemas/**,
			**/*.xsd,
			**/*.wsdl,
			**/*.xml,
			**/*.properties,
			**/*.jsp,
			**/*.html,
			**/*.css,
			**/*.js,
			**/*.json,
			**/*.yml,
			**/*.yaml,
			**/*.md,
			**/*.sql,
			**/*.txt,
			**/resources/**,
			**/webapp/**,
			**/META-INF/**
		</sonar.exclusions>
	</properties>
