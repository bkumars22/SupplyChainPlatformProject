<e2i2:buttonbar newrowcount="3">
	<c:if test="${!empty bomManagementForm.previousAction}">
		<e2i2:button id="backButton"
			onclick="javascript:goBack(document.forms['bomManagementForm'],'${fn:escapeXml(bomManagementForm.previousAction)}')">
			<bean:message key="button.back" />
		</e2i2:button>
	</c:if>
	<c:if test="${!empty bomManagementForm.nextAction}">
		<e2i2:button id="nextButton"
			onclick="javascript:goNext(document.forms['bomManagementForm'],'${fn:escapeXml(bomManagementForm.nextAction)}');">
			<bean:message key="button.next" />
		</e2i2:button>
	</c:if>
</e2i2:buttonbar>