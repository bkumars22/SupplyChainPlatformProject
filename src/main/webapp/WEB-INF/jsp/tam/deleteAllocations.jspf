									style="font-size: 2.5rem; margin-left: 10px;" title="No;">
									<i class="md-icon  mtcm_icon"></i>
								</label>
							</c:if>
							<label style="font-weight: bold; margin-left: 2rem;">
								${inherited.key.site.siteDescription}</label>
							<c:if test="${inherited.key.supplierAllocation == 'local'}">
								<label
									class="eto-dropdown__toggle eto-btn eto-btn--link eto-btn--icon-only large-icon"
									style="font-size: 2.5rem; padding-top: 10px;"
									title="<fmt:message key="info.TAM.delete.tooltip.local" />">
									<i class="md-icon" style="color: gray;">lens</i>
								</label>
							</c:if>
							<c:if test="${inherited.key.supplierAllocation == 'None'}">
								<label
									class="eto-dropdown__toggle eto-btn eto-btn--link eto-btn--icon-only large-icon"
									style="font-size: 2.5rem; padding-top: 10px;"
									title="<fmt:message key="info.TAM.delete.tooltip.No" />">
									<i class="md-icon" style="color: gray;">block</i>
								</label>
							</c:if>
							<c:if test="${inherited.key.supplierAllocation == 'inherited'}">
								<label
									class="eto-dropdown__toggle eto-btn eto-btn--link eto-btn--icon-only large-icon"
									style="font-size: 2.5rem; padding-top: 10px;"
									title="<fmt:message key="info.TAM.delete.tooltip.inherited">
								 <c:if test="${tamLevel != 'WW'}">
								<fmt:param value="WW"/>
								</c:if>
								<c:if test="${tamLevel == 'WW'}">
								<fmt:param value="${tamLevel}"/>
								</c:if>
								</fmt:message>">
									<i class="md-icon" style="color: orange;">data_usage</i>
