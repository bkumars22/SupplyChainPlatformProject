					</div></li>
				<c:if test="${not empty inherited.value}">
					<li data-depth="1" class="hidden" style="height: auto !important;">
						<div class="eto-tree-list__indent" style="margin-left: 16px;"></div>
						<div class="eto-tree-list__content" style="display: flex;">
							<div class="col-xs-12 col-sm-${7-columnCount}">
								<fmt:formatNumber
									value="${(fn:length(inherited.value)/columnCount) + ((fn:length(inherited.value)/columnCount) % 1 == 0 ? 0 : 0.5)}"
									type="number" pattern="#" var="totalRegion" />
								<c:set var="actualTotalRowCount" value="${totalRegion}" />
								<ul class="eto-tree-list" id="tree-list-parent-${treeCountId}">
									<c:forEach items="${inherited.value}" var="value"
										varStatus="row">

										<c:if test="${value.supplierAllocation == 'inherited'}">
											<c:set var="siteCheckboxValue" value="inherited" />
										</c:if>

										<c:if test="${value.supplierAllocation == 'partial'}">
											<c:set var="siteCheckboxValue" value="partial" />
										</c:if>

										<li data-depth="0"><c:if
												test="${value.supplierAllocation == 'inherited'}">
												<label class="eto-checkbox"
													style="width: 2rem; margin-left: 2rem;"> <input
