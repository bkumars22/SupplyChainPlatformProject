		function goReset() {
			document.forms[0].action = "resetTAM.do";
			document.forms[0].submit();
			showWaitBusy();
		}
		
		<c:if test="${!empty tamAllocationForm.allocation}">
			$('div.eto-grid table tbody td').css('height','6rem');
			$('div.eto-grid table thead th').css('height','6rem');
			gridObj = new eto.Grid({ el: document.querySelector('#allocationMainDiv') });
			let currentFrozenTableWidth = $('div.eto-grid-frozen > table').css('width');
			if(currentFrozenTableWidth.substring(0,currentFrozenTableWidth.length-2) < 220){
				$('div.eto-grid-frozen > table').css('width','220px');
			}else if(currentFrozenTableWidth.substring(0,currentFrozenTableWidth.length-2) > 220){
				$('div.eto-grid-frozen > table').css('width','auto');
			}
			$('div.eto-grid-scroll > table').css('width','auto');
		</c:if>
		
		function updateTotalPercentage(){
			var total = 0;
			for(var i = 0 ; i < fiscalPeriodDates.length ; i++){
				$('input[name^="supplierData('+fiscalPeriodDates[i].dates+'-"]input[name$=".supplierAllocation"]').each(function() {
					if(isNaN(this.value) || $.trim(this.value).length == 0){
						if($(this).val().length != 0 ){
							showOkMessageBox('OK','WARN',"<fmt:message key='warn.error_wrong_data_type'/>","<fmt:message key='msg.warn'/>",function() {});	
						}
						$(this).val('');
					}else{
						if (this.value != '') {
							$(this).val(parseInt($(this).val()));
							total = total + parseInt(this.value);
						}	
					}
					});
					if($('input[name=inheritValue][value='+fiscalPeriodDates[i].milis+']').prop("checked") == true){
						if(total < $('input[name="minHedging"]').val() || total > $('input[name="maxHedging"]').val()){
							$("td[name='"+fiscalPeriodDates[i].dates+"']").addClass("errorBorder");
							$("td[name='"+fiscalPeriodDates[i].dates+"']").attr("data-message-type","error");
						}else{
							$("td[name='"+fiscalPeriodDates[i].dates+"']").removeClass("errorBorder");
							$("td[name='"+fiscalPeriodDates[i].dates+"']").removeAttr( "data-message-type");
						}	
					}else{
					
						$("td[name='+fiscalPeriodDates[i].dates+']").removeClass("errorBorder");
						$("td[name='+fiscalPeriodDates[i].dates+']").removeAttr( "data-message-type");
					}
					$("td[name='"+fiscalPeriodDates[i].dates+"']").html(total);
					total = 0;
			}
			
			if($('input[name=showMRPVolume]').prop("checked") == false){
				calCulateMrp();	
			}
			
		}
		
		function updatePeriodPercentage(period){
			var total = 0;
			var calculatedMrp = 0;
			for(var i = 0 ; i < fiscalPeriodDates.length ; i++){
				if(period == fiscalPeriodDates[i].dates){
				$('input[name^="supplierData('+fiscalPeriodDates[i].dates+'-"]input[name$=".supplierAllocation"]').each(function() {
					if(isNaN(this.value) || $.trim(this.value).length == 0){
						if($(this).val().length != 0 ){
							showOkMessageBox('OK','WARN',"<fmt:message key='warn.error_wrong_data_type'/>","<fmt:message key='msg.warn'/>",function() {});	
						}
						$(this).val('');
					}else{
						if (this.value != '') {
							$(this).val(parseInt($(this).val()));
							total = total + parseInt(this.value);
						}	
					}
					});
					if($('input[name=inheritValue][value='+fiscalPeriodDates[i].milis+']').prop("checked") == true){
						if(total < $('input[name="minHedging"]').val() || total > $('input[name="maxHedging"]').val()){
							$('td[name='+fiscalPeriodDates[i].dates+']').addClass("errorBorder");
							$('td[name='+fiscalPeriodDates[i].dates+']').attr("data-message-type","error");
						}else{
							$('td[name='+fiscalPeriodDates[i].dates+']').removeClass("errorBorder");
							$('td[name='+fiscalPeriodDates[i].dates+']').removeAttr( "data-message-type");
						}	
					}else{
						$('td[name='+fiscalPeriodDates[i].dates+']').removeClass("errorBorder");
						$('td[name='+fiscalPeriodDates[i].dates+']').removeAttr( "data-message-type");
					}
					$('td[name^="supplierMrpData('+fiscalPeriodDates[i].dates+'-"]td[name$=".supplierAllocation"]').each(function() {
						   var value = $(this).text().trim();
						   if (!isNaN(value) && value!='') {
								$(this).text(parseFloat(value));
								calculatedMrp  += parseInt($(this).text());
							}else{
								 value = 0;
							}
						   if (!isNaN(value)) {
								$(this).find('div > input').html(parseFloat(value));
								calculatedMrp  += parseInt($(this).find('div > input ').val());
							}
					});
					$('td[name=calculatedData${sub.startDate}] > div > input').val(calculatedMrp);
					$('td[name=${sub.startDate}] > div').text(total);
					total = 0;
					calculatedMrp = 0;
				}
			}
			calCulatePeriodMrp(period);
		}
		
		function autoAllowHedging(){
			var checkHedge =[];
			var checkHedgeFlag = false;
			var minHedge = ${empty tamAllocationForm.minRange ? 100 : tamAllocationForm.minRange};
			for(var i = 0 ; i < fiscalPeriodDates.length ; i++){
				var value = $('td[name^="'+fiscalPeriodDates[i].dates+'"]').text().trim();
				checkHedge[i]=value;
			}
			
			if(checkHedge.length>0){
				for (i = 0; i < checkHedge.length; i++) {
					if((checkHedge[i]!=100 && checkHedge[i]!=0) && (checkHedge[i]>=minHedge) ){
						checkHedgeFlag = true;
						break;
					}
				}
				if (checkHedgeFlag) { 
					$('input[name=allowHedging]').prop("checked",true);
				} 
				else { 
					$('input[name=allowHedging]').removeAttr("checked");
				} 
			} 
			if($('input[name=allowHedging]').prop("checked") == true){
				$('input[name="minHedging"]').val(${tamAllocationForm.minRange});
				$('input[name="maxHedging"]').val(${tamAllocationForm.maxRange});
			}else{
				$('input[name="minHedging"]').val(100);
				$('input[name="maxHedging"]').val(100);
			}
		}
		
		
		function calCulateMrp(){
			for(var i = 0 ; i < fiscalPeriodDates.length ; i++){
				for(var j = 0 ; j < mrpDatas.length ; j++){
					var actualMrp = $('div[name="actualMrp_'+fiscalPeriodDates[i].dates+'"]').text();
					if(actualMrp){
		    			actualMrp = parseFloat(actualMrp.trim());
		    		}
					var supplierAllocation = $('input[name="supplierData('+fiscalPeriodDates[i].dates+'-'+mrpDatas[j].supplier+').supplierAllocation"]').val();
					if(actualMrp==0 || (isNaN(supplierAllocation)) || supplierAllocation=="" ){
						$('td[name="supplierMrpData('+fiscalPeriodDates[i].dates+'-'+mrpDatas[j].supplier+').supplierAllocation"] > div').text("");
					}else{
						let value = parseInt(parseFloat(actualMrp)*parseFloat(supplierAllocation)/100);
						if(isNaN(value)){
							$('td[name="supplierMrpData('+fiscalPeriodDates[i].dates+'-'+mrpDatas[j].supplier+').supplierAllocation"]  > div').text();							
						}else{
							$('td[name="supplierMrpData('+fiscalPeriodDates[i].dates+'-'+mrpDatas[j].supplier+').supplierAllocation"]  > div').text(value);	
						}
					}
					for(var k = 0 ; k < mrpDatas[j].items.length ; k++){
	 					var supplierMrpData = parseFloat($('td[name="supplierMrpData('+fiscalPeriodDates[i].dates+'-'+mrpDatas[j].supplier+').supplierAllocation"] > div').text());
    						var itemAllocation = $("input[name='supplierData("+fiscalPeriodDates[i].dates+"-"+mrpDatas[j].supplier+").itemData("+mrpDatas[j].items[k]+").itemAllocation']").val();
    						if((isNaN(itemAllocation) || (isNaN(supplierAllocation) || actualMrp==0)) || isNaN(supplierMrpData) || supplierMrpData=="" ){
								$('td[name="itemMrpData(supplierData('+fiscalPeriodDates[i].dates+'-'+mrpDatas[j].supplier+').itemData('+mrpDatas[j].items[k]+')).itemAllocation"] > div').text('');
							}else{
								if(supplierMrpData=="" || (supplierAllocation=="" && isNaN(supplierMrpData))){
									$('td[name="itemMrpData(supplierData('+fiscalPeriodDates[i].dates+'-'+mrpDatas[j].supplier+').itemData('+mrpDatas[j].items[k]+')).itemAllocation"] > div').text('');	
								}
								else{
									$('td[name="itemMrpData(supplierData('+fiscalPeriodDates[i].dates+'-'+mrpDatas[j].supplier+').itemData('+mrpDatas[j].items[k]+')).itemAllocation"] > div').text(parseInt(supplierMrpData*itemAllocation/100));
								}
							}
						}
					}
				var calculatedMrp = 0;
				$('td[name^="supplierMrpData('+fiscalPeriodDates[i].dates+'-"]td[name$=".supplierAllocation"]').each(function() {
					   	var current  = $(this).find('div');
						var value = current.text();
					   	if (!isNaN(value) && value!='') {
							current.val(parseFloat(value));
							calculatedMrp  += parseInt(value );
					}else{
							 value = 0;
						}
				});
				$('div[name="calculatedData'+fiscalPeriodDates[i].dates+'"]').text(parseInt(calculatedMrp));
			}
		}

		
		function copySupplierAllocationsForward(fromCopyDate,rowCount,inactiveCount,valueForCheckBox){
			var currentCheck = $('input[name="inheritValue"][value="'+valueForCheckBox+'"]').prop("checked");
			<c:forEach var="supplier" items="${tamAllocationForm.businessEntityItemList}">
				var valueToCopy = $("input[name='supplierData(" + fromCopyDate + "-${supplier.key.businessEntityKey}).supplierAllocation']").val();
				$('input[name$="-${supplier.key.businessEntityKey}).supplierAllocation"]').each(function(index){
					if(index+1 >= rowCount){
						$(this).val(valueToCopy);
					}
				});
			</c:forEach>
			
			$('input[name="inheritValue"]').each(function(){
				if($(this).val() >= valueForCheckBox){
					$(this).prop("checked",currentCheck);
				}
			});
			
			updateTotalPercentage();
			onValueChange();
		}
		
		function copyItemAllocationsForward(fromCopyDate,rowCount,inactiveCount,valueForCheckBox){
			var currentCheck = $('input[name="inheritItemValue"][value="'+valueForCheckBox+'"]').prop("checked");
			<c:forEach var="supplier" items="${tamAllocationForm.businessEntityItemList}">
				<c:forEach var="item" items="${supplier.value}">
					var valueToCopy = $("input[name='supplierData(" + fromCopyDate + "-${supplier.key.businessEntityKey}).itemData(${item.itemKey}).itemAllocation']").val();
					$('input[name$="-${supplier.key.businessEntityKey}).itemData(${item.itemKey}).itemAllocation"]').each(function(index){
						if(index > rowCount-inactiveCount-1){
							$(this).val(valueToCopy);
						}
					});
				</c:forEach>
			</c:forEach>
			
			$('input[name="inheritItemValue"]').each(function(){
				if($(this).val() >= valueForCheckBox){
					$(this).prop("checked",currentCheck);
				}
			});
			
			checkAllItemAllocation();
			onValueChange();
		}
		
		
		
