<script>
		let fiscalPeriodDates = [];
		let mrpDatas = [];

		function init() {
			loadPreference();
			regionComboBox.enable();
			<c:if test="${tamAllocationForm.massUpdateNoParentError}">
				setTimeout(function() {addParent();},2000);
			</c:if>
			<c:if test="${tamAllocationForm.deleteValuesCollected == 'true' }">
			setTimeout(function() {deleteFullModal();},2000);
			$("input[name='deleteValuesCollected']").val('noScreen');
			</c:if>
			<c:if test="${tamAllocationForm.deleteValuesCollected == 'false' }">
			setTimeout(function() {noModalToDelete();},500);
			$("input[name='deleteValuesCollected']").val('noScreen');
			</c:if>
			<c:if test="${tamAllocationForm.deleteValuesCollected == 'final' }">
			goSearch();
			$("input[name='deleteValuesCollected']").val('noScreen');
			</c:if>
			$("#pastDateChange").val('${tamAllocationForm.searchStartDate}');
		}

		function goDel() {
			document.forms[0].action = "delTAM.do";
			document.forms[0].submit();
			showWaitBusy();
		}
		
		function deleteFromSite() {
			var mod = new eto.Modal({
				el : document.querySelector('#delete-from-site-level-modal')
			});
			mod.open();			
		}

		function deleteFullModal() {
			parent.$('#contentFrame').contents().find('html').css("overflow-y","hidden");
      		$('#BothLocal').hide();
      		$('#BothInherited').hide();
      		$('#SupplierLocal').hide();
      		$('#SupplierInherited').hide();
      		$('#ItemLocal').hide();
      		$('#ItemInherited').hide();
      		$('#ItemAll').hide();
      		$('#SupplierAll').hide();
      		screenType = new eto.TreeList({ el: document.querySelector('#BothAll') });
			var mod = new eto.Modal({
				el : document.querySelector('#Delete-Allocation-full-screen')
			});
			mod.on('closed', function(query) {	
			parent.$('#contentFrame').contents().find('html').css("overflow-y","");	
			});
			mod.open(); 
		}
		
		function noModalToDelete(){
			var mod = new eto.Modal({
				el : document.querySelector('#fresh-TAM-error-modal')
			});
			mod.open();	 			
		}
		
		function deleteSite() {
			var type = $('#deleteFrame').contents().find('input[name="siteDeleteAllocationType"]:checked').val();
			$('input[name="allocationTypeDelete"]').val(type);	
			document.forms[0].action = "delSelected.do";
			document.forms[0].submit();
			showWaitBusy();		
			
		}
		
		function deleteAllocation(){
			parent.$('#contentFrame').contents().find('html').css("overflow-y","overlay");
			document.forms[0].action = "delSelected.do";
			document.forms[0].submit();
			showWaitBusy();					
		}
		
		function deleteSelected() {
			var deleteList = [];
			var region = '${tamAllocationForm.getRegion()}';
			var type = $('input[name="allocationType"]:checked').val();			
			$('#deleteAllocation > #deleteThisValue > ul:not([style*="display: none"])').find('input[type ="checkbox"]:checked').each(function() {
				deleteList.push(this.value);
			});
			$('input[name="selectedSite"]').val(deleteList);
			$('input[name="allocationTypeDelete"]').val(type);
			if (deleteList.length == 0) {
				showOkMessageBox(
						'OK',
						'WARN',
						"<fmt:message key='warn.functionalGroup.no_row_selected_to_delete'/>",
						"<fmt:message key='msg.warn'/>", function() {
						});
			}
						
			else if (region == ""){
				
				var selectedDiv = $('input[name ="allocationType"]:checked').val();
									
				switch(selectedDiv){
				case 'both':
					selectedDiv = 'BothAll';
					break;
					
				case 'supplier':
					selectedDiv = 'SupplierAll';
					break;
						
				case 'item':
				selectedDiv = 'ItemAll';
				break;
			
				}
			    let error = false; 
				$('#deleteAllocation > #deleteThisValue > ul:not([style*="display: none"])').find('input[name="regionDeleteList"][type ="checkbox"]:checked').each(function(){
					
					var regionPermission = 'Delete-region';
										
					var resultSet = ${e2ofn:hasAccess(appContext, 'TAM', regionPermission)};
					
                     if ($('#'+selectedDiv).find('input[name="siteDeleteList"][type ="checkbox"]:not(:checked).PartialFromRegion.child_'+$(this).val()+'').length > 0)
                     
                     {
                    	 if($('#deleteAllocation > #deleteThisValue > ul:not([style*="display: none"])').find('input[value = "1"][type ="checkbox"]:checked').length > 0){
                    		error = true;
							showOkMessageBox(
									'OK',
									'WARN',
									"<fmt:message key='warn.functionalGroup.region.has.dependency'/>",
									"<fmt:message key='msg.warn'/>", function() {
									});
							return;
							
							

						}
                    	 
                    	 if($('#'+selectedDiv).find('input[value = "1"][type ="checkbox"]').length < 1){
                    		 error = true;
 							showOkMessageBox(
 									'OK',
 									'WARN',
 									"<fmt:message key='warn.functionalGroup.region.has.dependency.no.global'/>",
 									"<fmt:message key='msg.warn'/>", function() {
 									});
 							return;
 							
 						}	
					}
                     
                     if ($('#'+selectedDiv).find('input[name="siteDeleteList"][type ="checkbox"]:not(:checked).global_No.PartialFromRegion.child_'+$(this).val()+'').length > 0)
                         
                     {
                    		 error = true;
 							showOkMessageBox(
 									'OK',
 									'WARN',
 									"<fmt:message key='warn.functionalGroup.region.has.dependency.no.global'/>",
 									"<fmt:message key='msg.warn'/>", function() {
 									});
 							return;
					}
                     
                	 if ($('#'+selectedDiv).find('input[name="siteDeleteList"][type ="checkbox"]:not(:checked).partial.child_'+$(this).val()+'').length > 0)
                         
                     {
                    	 if($('#'+selectedDiv).find('input[value = "1"][type ="checkbox"]').length < 1){
                    		 error = true;
 							showOkMessageBox(
 									'OK',
 									'WARN',
 									"<fmt:message key='warn.functionalGroup.region.has.dependency.no.global'/>",
 									"<fmt:message key='msg.warn'/>", function() {
 									});
 							return;
 							
 						}	
					}
                     
                     if (!resultSet) {
                    	 error = true;
							showOkMessageBox(
									'OK',
									'WARN',
									"<fmt:message key='warn.functionalGroup.region.has.no.permission'/>",
									"<fmt:message key='msg.warn'/>", function() {
									});
							return; 
                    	 
                    	 
                     }
                     	
					
				});	
				
				$('#deleteAllocation > #deleteThisValue > ul:not([style*="display: none"])').find('input[name="siteDeleteList"][type ="checkbox"]:checked').each(function(){
			    	 
                    var sitePermission = 'Delete-site';
					
					var siteResultSet = ${e2ofn:hasAccess(appContext, 'TAM', sitePermission)}; 
					
					if (!siteResultSet){
						error = true;
						showOkMessageBox(
								'OK',
								'WARN',
								"<fmt:message key='warn.functionalGroup.site.has.no.permission'/>",
								"<fmt:message key='msg.warn'/>", function() {
								});
						return; 						
						}
				});
				if(error){
					
					return;
				}
		     if ($('#deleteAllocation > #deleteThisValue > ul:not([style*="display: none"])').find('input[value = "1"][type ="checkbox"]:checked').length > 0){
				if ($('#'+selectedDiv).find('input[type ="checkbox"]:not(:checked).partial').length > 0){
					showOkMessageBox(
							'OK',
							'WARN',
							"<fmt:message key='errors.allocation.delete.error'/>",
							"<fmt:message key='msg.warn'/>", function() {
							});
				}
				else {
					var mod = new eto.Modal({
						el : document.querySelector('#final-TAM-delete-modal')
					});
					mod.open(); 				
				}
		}
		else {
			
			var mod = new eto.Modal({
				el : document.querySelector('#final-TAM-delete-modal')
			});
			mod.open(); 	
		}
		     }
			
			else if (region != ""){
				
				var selectedDiv = $('input[name ="allocationType"]:checked').val();
				
				switch(selectedDiv){
				case 'both':
					selectedDiv = 'BothAll';
					break;
					
				case 'supplier':
					selectedDiv = 'SupplierAll';
					break;
						
				case 'item':
				selectedDiv = 'ItemAll';
				break;
			
				}
				
				var selecetedType = $('input[name ="FurtherType"]:checked').val();
				
				let error = false;
				
				$('#deleteAllocation > #deleteThisValue > ul:not([style*="display: none"])').find('input[name="regionDeleteList"][type ="checkbox"]:checked').each(function(){
					
					if (selectedType = 'LocalData') {
					
                    if ($('#'+selectedDiv).find('input[name="siteDeleteList"][type ="checkbox"]:not(:checked).partial.global_No').length > 0)
                    
                    {
                    	error = true;
							showOkMessageBox(
									'OK',
									'WARN',
									"<fmt:message key='warn.functionalGroup.region.has.dependency.from.region.level'/>",
									"<fmt:message key='msg.warn'/>", function() {
									});
							return;
					}
					}
					
					else{
						
						if ($('#deleteAllocation > #deleteThisValue > ul:not([style*="display: none"])').find('input[name="siteDeleteList"][type ="checkbox"]:not(:checked).partial.global_No').length > 0)
		                    
	                    {
							error = true;
								showOkMessageBox(
										'OK',
										'WARN',
										"<fmt:message key='warn.functionalGroup.region.has.dependency.from.region.level'/>",
										"<fmt:message key='msg.warn'/>", function() {
										});
								return;
						}	
						
					}
                    	
					
				});
				
				$('#deleteAllocation > #deleteThisValue > ul:not([style*="display: none"])').find('input[name="siteDeleteList"][type ="checkbox"]:checked').each(function(){
						    	 
			    	 var sitePermission = 'Delete-site';
						
						var siteResultSet = ${e2ofn:hasAccess(appContext, 'TAM', sitePermission)}; 
						
						if (!siteResultSet){
							error = true;
							showOkMessageBox(
									'OK',
									'WARN',
									"<fmt:message key='warn.functionalGroup.site.has.no.permission'/>",
									"<fmt:message key='msg.warn'/>", function() {
									});
							return; 							
						}
				});
				if(error){
					return;
				}
								
		
					if ($('#deleteAllocation > #deleteThisValue > ul:not([style*="display: none"])').find('input[type ="checkbox"]:checked').val() == region )
					{
						if (selecetedType == 'LocalData') {
					if ($('#'+selectedDiv).find('input[type ="checkbox"]:not(:checked).partial').length > 0){
						showOkMessageBox(
						'OK',
						'WARN',
						"<fmt:message key='errors.allocation.delete.error'/>",
						"<fmt:message key='msg.warn'/>", function() {
						});										
					}
					
                     else{
						
                    	 var mod = new eto.Modal({
     						el : document.querySelector('#final-TAM-delete-modal')
     					});
     					mod.open(); 
					}
										
						}
						
						else{
							
							if ($('#deleteAllocation > #deleteThisValue > ul:not([style*="display: none"])').find('input[type ="checkbox"]:not(:checked).partial').length > 0){
								showOkMessageBox(
								'OK',
								'WARN',
								"<fmt:message key='errors.allocation.delete.error'/>",
								"<fmt:message key='msg.warn'/>", function() {
								});										
							}	
							
							else{
								
								var mod = new eto.Modal({
									el : document.querySelector('#final-TAM-delete-modal')
								});
								mod.open(); 
								
							}
							
						}
					}
						
					else{
						
						var mod = new eto.Modal({
							el : document.querySelector('#final-TAM-delete-modal')
						});
						mod.open(); 
					}
				
			}
		}

		function changeSearchField(current) {
			if (current == 'global') {
				$('#regionDiv').css("display", "none");
				$('#siteDiv').css("display", "none");
			}
			if (current == 'region') {
				$("#regionDiv").css("display", "");
				$('#siteDiv').css("display", "none");
			}
			if (current == 'site') {
				$('#siteDiv').css("display", "");
				$('#regionDiv').css("display", "");
			}
		}
		$(document).ready(
				function() {
					
					setFiscalObject();
					setMRPData();
					
					$(window).keydown(function(event){
					    if(event.keyCode == 13) {
					      event.preventDefault();
					      return false;
					    }
					 });
					
					changeSearchField('${tamAllocationForm.siteType}');
					
					if($('input[name="allowHedging"]').prop("checked") == true){
						$('input[name="minHedging"]').val(${tamAllocationForm.minRange});
						$('input[name="maxHedging"]').val(${tamAllocationForm.maxRange});
					}else{
						$('input[name="minHedging"]').val(100);
						$('input[name="maxHedging"]').val(100);
					}
					
					updateTotalPercentage();
					
					checkAllItemAllocation();
					
					autoAllowHedging();
					
					if($("input[name='copyAllocationToOther']").prop("checked") == true){
						$("#copyAllocation").show();						
						$('#copyAllocationButton').removeAttr("disabled");
					}else{
						$("#copyAllocation").hide();
						$('#copyAllocationButton').attr("disabled", 'disabled');
					}
					$("input[name='collaspseAllSites']").prop("checked",true);
					
					$('input[name="showMRPVolume"]').click(function(){
						hideMrp();
				    });

					$('input[name="pastScreen"]').change(function(){
				            if($('input[name="pastScreen"]:checked').val() == 'true'){
				            	goToPastScreen();
				            }else{
				            	goToCurrentScreen();
				            }
				    });
					
					$('input[name="hideSupplier"]').click(function(){
				        if($('input[name="hideSupplier"]').prop("checked") == true){
				        	$('input[name="hideSupplierWithNoAllocationPref"]').val(true);
				        	$(".hideSupplierWithNoAllocation").hide();
				        	if($('input[name="hideItem"]').prop("checked") == true){
				        		$(".hideItemAllocation").hide();
				        	}
				        }else{
				        	$('input[name="hideSupplierWithNoAllocationPref"]').val(false);
				        	$(".hideSupplierWithNoAllocation").show();
				        	if($('input[name="hideItem"]').prop("checked") == true){
				        		$(".hideItemAllocation").hide();
				        	}else{
				        		$(".hideItemAllocation").show();
				        	}
				        }
				    });

					
					$('input[name="hideItem"]').click(function(){
						hideItemChain();
				    });
					
					$('input[name="allowHedging"]').click(function(){
						if($('input[name="allowHedging"]').prop("checked") == true){
							$('input[name="minHedging"]').val(${tamAllocationForm.minRange});
							$('input[name="maxHedging"]').val(${tamAllocationForm.maxRange});
						}else{
							$('input[name="minHedging"]').val(100);
							$('input[name="maxHedging"]').val(100);
						}
						$('input[name="unsavedData"]').val(true);
						updateTotalPercentage();
						checkAllItemAllocation();
					});
					
					$(document).mouseup(function (e){
						$(".popUpDiv").fadeOut();
					}); 
					
					
					var menuOn = false;
					$( "#downloadButtonId" )
					  .mouseenter(function() {
						$('#downloadMenu').css('display', "block");
					  }).mouseleave(function() {
						  setTimeout(function() {
								if(!menuOn){
									$('#downloadMenu').css('display', "none");
									menuOn = false;
								}
							}, 1000);
					  });
					
					$( "#downloadMenu" )
					 .mouseenter(function() {
						menuOn = true;
					  })
					  .mouseleave(function() {
						  $('#downloadMenu').css('display', "none");
						  menuOn = false;
					  });
					  
					if($("input[name='selectedFgType']:checked").val() == 'XLOB'){
						disableSiteForXLOB();
					}
					
					$("input[name='selectedFgType']").click(function(){
						if($("input[name='selectedFgType']:checked").val() == 'XLOB'){
							disableSiteForXLOB();
						}else{
							$("input[name='toggle-tamPlanner']").removeAttr('disabled');
						}
					});
					
					$('input.toogleTd').click(function() {
						$('input[name="siteType"]').val(this.id);
						$('input[name="freshSearch"]').val(false);
						if (!canChangeSiteType(goInit)) {
							return false;
						}
						changeSearchField(this.id);
					});
					
					
					$('input.toogleFgType').click(function() {
						$('input[name="freshSearch"]').val(false);
						if (!canChangeFgType(goInit)) {
							return false;
						}
						changeSearchField(this.id);
					});
					
					regionComboBox.on('change:value',function() {
						$('input[name="freshSearch"]').val(false);
							if (!canChangeSiteType(goInit)) {
								return false;
							}
							if(regionComboBox.getValue() != ''){
								regionComboBox.disable();
								$.ajax({
									type: "POST",
									url: 'setRegion.do',
									cache: false,
									dataType: 'text',
									data: {
										freshSearch: false,
										region : regionComboBox.getValue()
									},
									success: function(result) {
										siteComboBox.setOptions(JSON.parse(result));
										regionComboBox.enable();
									},
									error: function(error){
										alert('error'+error.statusText);
									}
								}); 
							}else{
								siteComboBox.setOptions(JSON.parse('[{"label": "","value":""}]'));
							}
						});
					makeFullscreen('exit');
					loadCompleted();
				});
		
	function disableSiteForXLOB(){
		<c:if test="${!empty tamAllocationForm.xlobDisableSiteLevel}">
		switch('${tamAllocationForm.xlobDisableSiteLevel}') {
		  case 'WW':
		  	$("#global").attr('disabled','disabled');
		  case 'GLOBAL':
			  	$("#global").attr('disabled','disabled');
		  case 'REGION':
			$("#region").attr('disabled','disabled');
		  case 'SITE':
			$("#site").attr('disabled','disabled');
			break;
		}
		
		$("input[name='toggle-tamPlanner']").each(function(){
			if($(this).is('[disabled=disabled]') == false){
				$(this).click();
				 return false;
			}
		});
		</c:if>
	}
	function hideMrp(){
		   if($('input[name="showMRPVolume"]').prop("checked") == true){
				$('input[name="hideMRPPref"]').val(true);
     			$("#cmrptd").hide();
     			$("#amrptd").hide();
     			$('.mrpCol').hide();
     			$("#calculateMrpDiv").hide(); 
     			$("#totalMrpDiv").hide();
     			$('.eto-grid-scroll > table > thead > tr:first-child th').each(function(){
     				var colspan = parseInt($(this).prop('colspan'));
     				$(this).prop('colspan',(colspan- (colspan/3)));
     			});
     			
     			$('.monthDividerMrpExpand').addClass('monthDividerMrpCollapse');
     			$('.monthDividerMrpCollapse').removeClass('monthDividerMrpExpand');
	        }else{
	        	$('input[name="hideMRPPref"]').val(false);
	        	$("#cmrptd").show();
	        	$("#amrptd").show(); 
	        	$('.mrpCol').show();
	        	$("#calculateMrpDiv").show(); 
	        	$("#totalMrpDiv").show();
	        	calCulateMrp();
	        	checkAllItemAllocation();
	        	
				if($('input[name="hideItem"]').prop("checked") == false){
	        		$(".tamItemMrpValue").show();
	        	}
				$('.eto-grid-scroll > table > thead > tr:nth-child(1) th').each(function(){
     				var colspan = parseInt($(this).prop('colspan'));
     				$(this).prop('colspan',(colspan + (colspan/2)));
     			});
				
				$('.monthDividerMrpCollapse').addClass('monthDividerMrpExpand');
     			$('.monthDividerMrpCollapse').removeClass('monthDividerMrpCollapse');
	        }
	}			
	function closeDownloadMenu(){
		if($('#downloadMenu').css('display') === 'block' && downloadMenuOn){
			 $('#downloadMenu').css('display', "none");
		}
	}
	
	function trimValue(field) {
		var val = field.value;
		field.value = val.replace(/^\s+|\s+$/g,"");
	}
		function goClear() {
			//clear TAM search
			document.forms[0].action = "clearTAM.do";
			document.forms[0].submit();
			showWaitBusy();
		}

		function goSearch() {
			//search TAM
			document.forms[0].action = "searchTAM.do";
			document.forms[0].submit();
			showWaitBusy();
		}
		
		function goInit() {
			//init TAM
			document.forms[0].action = "manageTAM.do";
			document.forms[0].submit();
			showWaitBusy();
		}

		function goDownload(){
			document.forms[0].action = "downloadTAM.do";
			document.forms[0].submit();
		}
		
		function goToPastScreen(){
			document.forms[0].action = "showPastBucket.do";
			document.forms[0].submit();
			showWaitBusy();
		}
		
		function goToCurrentScreen(){
			document.forms[0].pastScreen.value = "false";
			goSearch();
		}
		
		function goSaveAndContinue() {
			var supplierErrorcount = 0;
			var itemErrorcount = 0;
			
			$( "td[data-message-type='high-severity']" ).each(function(index){
				itemErrorcount = index+1;
			});
			
			$( "td[data-message-type='error']" ).each(function(index){
				supplierErrorcount = index+1;
			});
			
			if(supplierErrorcount > 0){
				if($('input[name=allowHedging]').prop("checked") == true){
					showOkMessageBox('OK','WARN',"<fmt:message key='warn.supplier_error_exist_on_page_with_hedging'/>","<fmt:message key='msg.warn'/>",function() {});	
				}else{
					showOkMessageBox('OK','WARN',"<fmt:message key='warn.supplier_error_exist_on_page'/>","<fmt:message key='msg.warn'/>",function() {});
				}
			}else if(itemErrorcount > 0){
				showOkMessageBox('OK','WARN',"<fmt:message key='warn.item_error_exist_on_page'/>","<fmt:message key='msg.warn'/>",function() {});
			}else{
				document.forms[0].action = "saveTAM.do";
				document.forms[0].submit();
				showWaitBusy();
			}
		}
		
		function canLeavePage(callback) {
			if (document.forms[0].unsavedData.value == 'true') {
				showYesNoMessageBox('YES NO', 'WARN',
						"<fmt:message key='warn.changes_not_saved_yes_no'/>",
						"<fmt:message key='msg.warn'/>", callback);
				return false;
			}
			${tamAllocationForm.setFreshSearch(true)};
			return true;
		}
		
		function canChangeSiteType(callback) {
			var isEmpty = false;
			<c:if test="${!empty tamAllocationForm.allocation}">
				isEmpty = true;
			</c:if>
			if (isEmpty) {
			if (document.forms[0].unsavedData.value == 'true') {
				showYesNoMessageBox('YES NO', 'WARN',
						"<fmt:message key='warn.changes_not_saved_yes_no'/>",
						"<fmt:message key='msg.warn'/>", callback);
				return false;
				}
			if (document.forms[0].unsavedData.value == 'false') {
				callback.apply();
				return false;
				}
			}
			return true;
		}
		
		function canChangeFgType(callback) {
			var isEmpty = false;
			<c:if test="${!empty tamAllocationForm.allocation}">
				isEmpty = true;
			</c:if>
			if (isEmpty) {
			if (document.forms[0].unsavedData.value == 'true') {
				showYesNoMessageBox('YES NO', 'WARN',
						"<fmt:message key='warn.changes_not_saved_yes_no'/>",
						"<fmt:message key='msg.warn'/>", callback);
				return false;
				}
			if (document.forms[0].unsavedData.value == 'false') {
				callback.apply();
				return false;
				}
			}
			callback.apply();
			return false;
		}
		
