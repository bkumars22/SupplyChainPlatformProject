function selectAllDeleteSites(){ 
	var value = $("#selectAllDeleteSite").prop("checked");
	$('#deleteAllocation > #deleteThisValue > ul:not([style*="display: none"])').find('input[type ="checkbox"]').not(":disabled").prop('checked',value);
}

function selectRegionandSites(className){
$('#deleteAllocation > #deleteThisValue > ul:not([style*="display: none"])').find('input[type ="checkbox"].'+ className + ', .'+ className +'_0').not(":disabled").prop('checked',true);	
}

function selectRegion(className){
$('#deleteAllocation > #deleteThisValue > ul:not([style*="display: none"])').find('input[type ="checkbox"].'+ className + '').not(":disabled").prop('checked',true);
$('#deleteAllocation > #deleteThisValue > ul:not([style*="display: none"])').find('input[type ="checkbox"].'+ className +'_0').not(":disabled").prop('checked',false);
}

function selectSites(className){
$('#deleteAllocation > #deleteThisValue > ul:not([style*="display: none"])').find('input[type ="checkbox"].'+ className +'_0').not(":disabled").prop('checked',true);
$('#deleteAllocation > #deleteThisValue > ul:not([style*="display: none"])').find('input[type ="checkbox"].'+ className + '').not(":disabled").prop('checked',false);
}

