	$('#deleteAllocation > #deleteThisValue > ul:not([style*="display: none"])').find('input[type ="checkbox"].'+ className + ', .'+ className +'_0').not(":disabled").prop('checked',false);	
}
		
		function addParent() {
			let mod = new eto.Modal({
				el : document.querySelector('#error-modal')
			});
			mod.open();
