        function CreateParentGroupModal() {
        	showAssignOrCreateParentScreen('${tamAllocationForm.allocation.functionalGroup.functionalGroupId}','CREATE');
        }
        
        function AssignParentGroupModal() {
        	showAssignOrCreateParentScreen('${tamAllocationForm.allocation.functionalGroup.functionalGroupId}','ASSIGN');	     	
        }       
        
        function changePastUpdated(){
        	$('input[name="searchStartDate"]').val($('input[name="changePastDate"]').val());
			document.forms[0].action = "updateSearchDateCurrentScreen.do";
			document.forms[0].submit();
			showWaitBusy();
        }
        
        function tamDownlaodOption(downloadType) {
        	var checkFileCompletedHandler = null;
        	$('input[name="downloadOption"]').val(downloadType);
        	document.forms[0].action = "downloadTAM.do";
        	var num = Math.floor((Math.random() * 1000));
        	$('input[name="fileLocation"]').val(num);
        	document.forms[0].submit();
        	showWaitBusy();
        	document.forms[0].action = "searchTAM.do";
        	function checkFileCompleted(){
        		$.ajax({
        			type: "POST",
        			url: 'tamDownloadUtilCheck.do',
        			cache: false,
        			dataType: 'text',
        			data: {
        				downloadKey: num
        			},
        			success: function(result) {
        				if(result.match("^true")){
        					closeWaitBusy();
        					clearInterval(checkFileCompletedHandler);
        				}
        			},
        			error: function(error){
        				alert('error'+error.statusText);
        				closeWaitBusy();
        				clearInterval(checkFileCompletedHandler);
        			}
        		}); 
        	}
        	checkFileCompletedHandler = setInterval(function(){ checkFileCompleted() }, 3000);
        }
        
        function setFiscalObject(){
    		<c:forEach var="subHeader" items="${tamAllocationForm.header}" varStatus="count">
    			<c:forEach var="sub" items="${subHeader.value}" varStatus="row">
    				<c:if test="${tamAllocationForm.currentDate le sub.endDate}">
    					fiscalPeriodDates.push({dates:'${sub.startDate}',milis:'${sub.startDate.time}'});
    				</c:if>
    			</c:forEach>
    		</c:forEach>
    	}
        
        function setMRPData(){
			let itemKeys = [];
			<c:forEach var="supplier" items="${tamAllocationForm.businessEntityItemList}">
				itemKeys = [];
				<c:forEach var="item" items="${supplier.value}">
					itemKeys.push('${item.itemKey}');
				</c:forEach>
				mrpDatas.push({supplier : '${supplier.key.businessEntityKey}' , items : itemKeys});
			</c:forEach>
		}
        
        
        function calCulatePeriodMrp(period){
			for(var i = 0 ; i < fiscalPeriodDates.length ; i++){
				if(period == fiscalPeriodDates[i].dates){
				for(var j = 0 ; j < mrpDatas.length ; j++){
					var actualMrp = $('input[name="actualMrp_${sub.startDate}"]').val();
					if(actualMrp){
		    			actualMrp = parseFloat(actualMrp.trim());
		    		}
					var supplierAllocation = $('input[name="supplierData('+fiscalPeriodDates[i].dates+'-'+mrpDatas[j].supplier+').supplierAllocation"]').val();
					if(actualMrp==0 || (isNaN(supplierAllocation)) || supplierAllocation=="" ){
						$('td[name="supplierMrpData('+fiscalPeriodDates[i].dates+'-'+mrpDatas[j].supplier+').supplierAllocation"] > div input').val("");
					}else{
						let value = parseInt(parseFloat(actualMrp)*parseFloat(supplierAllocation)/100);
						if(isNaN(value)){
							$('td[name="supplierMrpData('+fiscalPeriodDates[i].dates+'-'+mrpDatas[j].supplier+').supplierAllocation"]  > div > input').val();							
						}else{
							$('td[name="supplierMrpData('+fiscalPeriodDates[i].dates+'-'+mrpDatas[j].supplier+').supplierAllocation"]  > div > input').val(value);	
						}
					}
					for(var k = 0 ; k < mrpDatas[j].items.length ; k++){
	 					var supplierMrpData = parseFloat($('td[name="supplierMrpData('+fiscalPeriodDates[i].dates+'-'+mrpDatas[j].supplier+').supplierAllocation"] > div > input').val());
    						var itemAllocation = $("input[name='supplierData("+fiscalPeriodDates[i].dates+"-"+mrpDatas[j].supplier+").itemData("+mrpDatas[j].items[k]+").itemAllocation']").val();
    						if((isNaN(itemAllocation) || (isNaN(supplierAllocation) || actualMrp==0)) || isNaN(supplierMrpData) || supplierMrpData=="" ){
								$('td[name="itemMrpData(supplierData('+fiscalPeriodDates[i].dates+'-'+mrpDatas[j].supplier+').itemData('+mrpDatas[j].items[k]+')).itemAllocation"] > div > input').val('');
							}else{
								if(supplierMrpData=="" || (supplierAllocation=="" && isNaN(supplierMrpData))){
									$('td[name="itemMrpData(supplierData('+fiscalPeriodDates[i].dates+'-'+mrpDatas[j].supplier+').itemData('+mrpDatas[j].items[k]+')).itemAllocation"] > div > input').val('');	
								}
								else{
									$('td[name="itemMrpData(supplierData('+fiscalPeriodDates[i].dates+'-'+mrpDatas[j].supplier+').itemData('+mrpDatas[j].items[k]+')).itemAllocation"] > div > input').val(parseInt(supplierMrpData*itemAllocation/100));
								}
							}
						}
					}
				}
			}
		}
</script>

<div class="eto-modal" id="error-modal">
	<div class="eto-modal__content col-xs-12 col-sm-8 col-lg-6 col-xl-4">
		<header class="eto-modal__header">
			<span>Error</span>
		</header>
		<section class="eto-modal__body">
			<p>
				<fmt:message key="context.link.tam.to.fg.edit" />
			</p>
		</section>
		<footer class="eto-modal__footer">
			<button class="eto-btn" data-modal-close>Cancel</button>
			<button class="eto-btn"
				onclick="javascript:CreateParentGroupModal();" data-modal-close>Create
				Parent Group</button>
			<button class="eto-btn"
				onclick="javascript:AssignParentGroupModal();" data-modal-close>Assign
				Parent Group</button>
		</footer>
	</div>
</div>