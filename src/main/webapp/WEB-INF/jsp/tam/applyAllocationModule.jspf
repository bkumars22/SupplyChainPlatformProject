<div class="row" style="display: none;">
	<div class="col-xs-12 col-sm-6 margin-top-sm-2">
		<div class="eto-toggle">
			<div class="eto-toggle__items">
				<label class="eto-toggle__item"> <input
					class="eto-toggle__input" type="radio" name="copyType" value="all"
					checked="checked" onchange="javascript:copyTypeChange();">
					<span class="eto-toggle__label"><fmt:message
							key="tam.copy_entire_allocation" /></span>
				</label>
				<!-- Below switch is disabled as part of SCPlatform-2646 -->
				<!--  
									<label class="eto-toggle__item"> <input
										class="eto-toggle__input" type="radio" name="copyType"
										value="dateRange" onchange="javascript:copyTypeChange();">
										<span class="eto-toggle__label"><fmt:message
												key="tam.copy_specific_allocation" /></span>
									</label>
									-->
			</div>
		</div>
	</div>
</div>

<div class="row margin-top-sm-3" id="dateRangeRow">
	<div class="col-xs-12 col-sm-12">
		<section class="eto-well" id="well-example-1"
			style="display: flex; height: 5%;">
			<label class="eto-combobox__label"
				style="position: relative; top: -10px; margin-right: 1%;"><fmt:message
					key="tam.from" /></label>
			<div class="eto-combobox" id="combobox-fromDateDropDown"
				style="margin-right: 5%; position: relative; top: -15px;">
				<div class="eto-combobox__field-container" role="presentation"
					aria-hidden="true">
					<input class="eto-combobox__field" type="text" name="startDate"
						autocomplete="off"> <span class="eto-combobox__btn">
						<button type="button" class="eto-btn eto-btn--icon-only">
							<span class="md-icon">expand_more</span>
						</button>
					</span>
				</div>
				<span class="eto-combobox__message"></span> <select>
					<c:forEach var="headerMonth" items="${tamAllocationForm.header}">
						<c:forEach items="${headerMonth.value}" var="dates">
							<fmt:formatDate var="month" pattern="dd/MM/YYYY"
								value="${dates.startDate}" />
							<c:if test="${dates.endDate ge tamAllocationForm.currentDate}">
								<option value="${month}">${month}</option>
							</c:if>
						</c:forEach>
					</c:forEach>
				</select>
				<div class="eto-results" role="listbox" aria-live="polite"
					aria-relevant="all"></div>
			</div>
			<label class="eto-combobox__label"
				style="position: relative; top: -10px; margin-right: 1%;"><fmt:message
					key="tam.to" /></label>
			<div class="eto-combobox" id="combobox-toDateDropDown"
				style="position: relative; top: -15px;">
				<div class="eto-combobox__field-container" role="presentation"
					aria-hidden="true">
					<input class="eto-combobox__field" type="text" name="endDate"
						autocomplete="off"> <span class="eto-combobox__btn">
						<button type="button" class="eto-btn eto-btn--icon-only">
							<span class="md-icon">expand_more</span>
						</button>
					</span>
				</div>
				<span class="eto-combobox__message"></span> <select>
					<c:forEach var="headerMonth" items="${tamAllocationForm.header}">
						<c:forEach items="${headerMonth.value}" var="dates">
							<fmt:formatDate var="month" pattern="dd/MM/YYYY"
								value="${dates.startDate}" />
							<fmt:formatDate var="monthEnd" pattern="dd/MM/YYYY"
								value="${dates.endDate}" />
							<c:if test="${dates.endDate ge tamAllocationForm.currentDate}">
								<option value="${month}">${monthEnd}</option>
							</c:if>
						</c:forEach>
					</c:forEach>
				</select>
				<div class="eto-results" role="listbox" aria-live="polite"
					aria-relevant="all"></div>
			</div>
		</section>
		<script>
			new eto.Combobox({
				el : document.querySelector('#combobox-fromDateDropDown')
			});
			new eto.Combobox({
				el : document.querySelector('#combobox-toDateDropDown')
			});
		</script>
	</div>
</div>

<div class="row margin-top-sm-2">
	<div class="col-xs-12 col-sm-2">
		<c:set var="currentSiteKey"
			value="${tamAllocationForm.allocation.site.siteKey}" />
		<label class="eto-checkbox"> <input
			class="eto-checkbox__field" type="checkbox" name="selectAllSite"
			onclick="selectAllSites();"> <span class="eto-checkbox__box"></span>
			<span class="eto-checkbox__label">Select All</span>
		</label>
	</div>
	<div class="col-xs-12 col-sm-2">
		<label class="eto-switch"> <input class="eto-switch__field"
			type="checkbox" name="collaspseAllSites"
			onclick="javascript:collapseAll()"> <span
			class="eto-switch__box"></span> <span class="eto-switch__label--on"><fmt:message
					key="tam.collaspseAllSite" /></span> <span class="eto-switch__label--off"><fmt:message
					key="tam.collaspseAllSite" /></span>
		</label>
	</div>
</div>


<div class="row margin-top-sm-2">
	<div class="col-xs-12 col-sm-12">
		<c:if test="${currentSiteKey != 1}">
			<label class="eto-checkbox"> <input
				class="eto-checkbox__field" type="checkbox" name="siteList"
				value="1"
				${appContext.currentRole.roleId == 'BUYER' ? 'disabled' : ''}>
				<span class="eto-checkbox__box"></span> <span
				class="eto-checkbox__label">Global (WW)</span>
			</label>
		</c:if>
	</div>
</div>


<!-- List of Site for Copy Allocation -->

<%@ include file="copySiteList.jspf"%>

<!-- List of Site for Copy Allocation -->