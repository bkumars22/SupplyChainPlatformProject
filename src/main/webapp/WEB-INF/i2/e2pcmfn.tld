<?xml version="1.0" encoding="UTF-8" ?>
<taglib xmlns="http://java.sun.com/xml/ns/j2ee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-jsptaglibrary_2_0.xsd"
	version="2.0">
	<description>E2open PCM function library library</description>
	<display-name>E2open PCM functions</display-name>
	<tlib-version>1.1</tlib-version>
	<short-name>e2pcmfn</short-name>
	<!--<uri>http://java.sun.com/jsp/jstl/core</uri>-->
	
	<tag>
		<name>escapePrint</name>
		<tag-class>com.scplatform.pcm.web.EscapePrinter</tag-class>
		<body-content>empty</body-content>
		<attribute>
			<name>value</name>
			<required>yes</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>removeColon</name>
			<required>no</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	
	<function>
		<description>Tests if user has access</description>
		<name>hasAccess</name>
		<function-class>
			com.scplatform.pcm.authentication.service.AppContextHelper
		</function-class>
		<function-signature>
		    boolean hasAccess(com.scplatform.pcm.authentication.dto.ApplicationContext, java.lang.String, java.lang.String)
		</function-signature>
		<example>
			&lt;c:if test="${e2ofn:hasAccess(appContext, resource, operation)}">
		</example>
	</function>
	
	<function>
		<description>Tests if user has access for specific cost type</description>
		<name>hasAccessForCostType</name>
		<function-class>
			com.scplatform.pcm.authentication.service.AppContextHelper
		</function-class>
		<function-signature>
		    boolean hasAccessForCostType(com.scplatform.pcm.authentication.dto.ApplicationContext, java.lang.String, java.lang.String, java.lang.String)
		</function-signature>
		<example>
			&lt;c:if test="${e2ofn:hasAccessForCostType(appContext, resource, operation, costType)}">
		</example>
	</function>
	
	<function>
		<description>Tests if user has access for a specific request event</description>
		<name>hasEventAccess</name>
		<function-class>
			com.scplatform.pcm.authentication.service.AppContextHelper
		</function-class>
		<function-signature>
		    boolean hasEventAccess(com.scplatform.pcm.authentication.dto.ApplicationContext, java.lang.String, java.lang.String)
		</function-signature>
		<example>
			&lt;c:if test="${e2ofn:hasEventAccess(appContext, requestType, operation)}">
		</example>
	</function>
	
	<function>
		<description>Tests if user has access for a specific request event based on cost type</description>
		<name>hasEventAccessForCostType</name>
		<function-class>
			com.scplatform.pcm.authentication.service.AppContextHelper
		</function-class>
		<function-signature>
		    boolean hasEventAccessForCostType(com.scplatform.pcm.authentication.dto.ApplicationContext, java.lang.String, java.lang.String, java.lang.String)
		</function-signature>
		<example>
			&lt;c:if test="${e2ofn:hasEventAccessForCostType(appContext, requestType, operation, costType)}">
		</example>
	</function>
	
<!-- Not currently supported
	<function>
		<description>
			Tests if user has access for a specific request event and
			needs assignment
		</description>
		<name>hasEventAssignmentAccess</name>
		<function-class>
			com.scplatform.pcm.web.ApplicationContext
		</function-class>
		<function-signature>
			boolean hasEventAssignmentAccess(com.scplatform.pcm.web.ApplicationContext,	com.scplatform.pcm.util.stateMachine.StateMachineEvent,com.test.repository.pcm.domain.PdcAssignment)
		</function-signature>

		<example>
			&lt;c:if
			test="${scplatformfn:hasEventAssignmentAccess(appContext, event,
			assignment)}">
		</example>
	</function>
 -->
	<function>
		<description>
			Returns a message from the localization context passed in.
		</description>
		<name>message</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>

		<function-signature>
			java.lang.String getMessage(java.util.ResourceBundle, java.lang.String)
		</function-signature>

		<example>${scplatformfn:message(resources.resourceBundle, 'myKey')}</example>
	</function>
	<function>
		<description>
			Returns a message from the localization context passed in with arg values
		</description>
		<name>getConfiguredMessage</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>

		<function-signature>
			java.lang.String getMessage(java.lang.String, java.lang.String,java.util.Locale)
		</function-signature>

		<example>${scplatformfn:getConfiguredMessage(key,arg,locale)}</example>
	</function>
	<function>
		<description>Abbreviates a string</description>
		<name>abbreviate</name>
		<function-class>
			org.apache.commons.lang3.StringUtils
		</function-class>

		<function-signature>
			java.lang.String abbreviate(java.lang.String, int)
		</function-signature>

		<example>
			${scplatformfn:abbreviate("ABCD",3")} results in ABC...
		</example>
	</function>
	
	<function>
		<description>get days old value from user as per record type</description>
		<name>getDayOldDashBoardCard</name>
		<function-class>
			com.scplatform.pcm.authentication.service.AppContextHelper
		</function-class>
		<function-signature>
		    int getDayOldDashBoardCard(com.scplatform.pcm.authentication.dto.ApplicationContext, java.lang.String)
		</function-signature>
		<example>
			${e2ofn:getDayOldDashBoardCard(appContext, 'costRecord')}
		</example>
	</function>

	<function>
		<description>Returns the user ID from the application context</description>
		<name>getUserId</name>
		<function-class>
			com.scplatform.pcm.authentication.service.AppContextHelper
		</function-class>
		<function-signature>
		    java.lang.String getUserId(com.scplatform.pcm.authentication.dto.ApplicationContext)
		</function-signature>
		<example>
			${e2ofn:getUserId(appContext)}
		</example>
	</function>

	<function>
		<description>Returns true if the application context has an authenticated user</description>
		<name>isAuthenticated</name>
		<function-class>
			com.scplatform.pcm.authentication.service.AppContextHelper
		</function-class>
		<function-signature>
		    boolean isAuthenticated(com.scplatform.pcm.authentication.dto.ApplicationContext)
		</function-signature>
		<example>
			&lt;c:if test="${e2ofn:isAuthenticated(appContext)}">
		</example>
	</function>

	<function>
		<description>Tests if user has access for a specific entity type key (4-param overload)</description>
		<name>hasAccessForEntity</name>
		<function-class>
			com.scplatform.pcm.authentication.service.AppContextHelper
		</function-class>
		<function-signature>
		    boolean hasAccess(com.scplatform.pcm.authentication.dto.ApplicationContext, java.lang.String, java.lang.String, java.lang.String)
		</function-signature>
		<example>
			&lt;c:if test="${e2ofn:hasAccessForEntity(appContext, 'BOM', 'Write', entityKey)}">
		</example>
	</function>

	<function>
		<description>Returns a system property value by key</description>
		<name>getSystemProperty</name>
		<function-class>
			com.scplatform.pcm.authentication.service.AppContextHelper
		</function-class>
		<function-signature>
		    java.lang.String getSystemProperty(java.lang.String)
		</function-signature>
		<example>
			${e2ofn:getSystemProperty('mtcm.launchpad.enabled')}
		</example>
	</function>

	<function>
		<description>Returns the accessible workflows menu as a JSON string</description>
		<name>getAccessableWorkflowsMenuStr</name>
		<function-class>
			com.scplatform.pcm.authentication.service.AppContextHelper
		</function-class>
		<function-signature>
		    java.lang.String getAccessableWorkflowsMenuStr(com.scplatform.pcm.authentication.dto.ApplicationContext)
		</function-signature>
		<example>
			${e2ofn:getAccessableWorkflowsMenuStr(appContext)}
		</example>
	</function>

    <!-- Data helpers -->
    <function>
		<description>Stack peek</description>
		<name>peek</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
		    java.lang.Object peek(java.util.Stack)
		</function-signature>
	</function>

    <function>
		<description>Stack pop</description>
		<name>pop</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
		    java.lang.Object pop(java.util.Stack)
		</function-signature>
	</function>

    <function>
		<description>Stack push</description>
		<name>push</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
		    java.lang.Object push(java.util.Stack, java.lang.Object)
		</function-signature>
	</function>
    
    <function>
		<description>Collection contains</description>
		<name>arrayContains</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
		    boolean arrayContains(java.lang.Object[], java.lang.Object)
		</function-signature>
	</function>

    <function>
		<description>Collection contains</description>
		<name>contains</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
		    boolean contains(java.util.Collection, java.lang.Object)
		</function-signature>
	</function>
    
	<function>
		<description>Add all values from a collection to a collection</description>
		<name>addAll</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
			java.util.Collection addAll(java.util.Collection, java.util.Collection)
		</function-signature>
	</function>
    
	<function>
		<description>Gets all the values from a Map</description>
		<name>getMapValues</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
			java.util.Collection getMapValues(java.util.Map)
		</function-signature>
	</function>
	<function>
		<description>Gets all the keys from a Map</description>
		<name>getMapKeys</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
			java.util.Set getMapKeys(java.util.Map)
		</function-signature>
	</function>
    
	<function>
		<description>Gets a contact for an item</description>
		<name>getContactForItem</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
			com.test.repository.bom.domain.common.Contact getContactForItem(java.lang.String)
		</function-signature>
	</function>
	<function>
		<description>Gets the AVL for an item</description>
		<name>getItemAvl</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
			java.util.Set getItemAvl(java.lang.String)
		</function-signature>
	</function>
	<function>
		<description>Returns true if the line identified by key is assigned to passed user
		             for any of the responsibilities listed in
		             dashboard.assignment_filter configuration value</description>
		<name>isAssignedTo</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
			boolean isAssignedTo(java.lang.String, com.test.repository.domain.pcm.Users)
		</function-signature>
	</function>

	<function>
		<description>Returns the states for the model specified</description>
		<name>getStates</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
			java.util.Map getStates(java.lang.String)
		</function-signature>
	</function>

	<function>
		<description>Returns true if state for the model specified allows operation</description>
		<name>allowOperation</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
			boolean getStateAllowsOperation(java.lang.String,java.lang.String,java.lang.String)
		</function-signature>
		<example>stateAllowsOperation('Forecast','CLOSED','Edit')
		         Can you edit a closed forecast</example>
	</function>
	
	<function>
		<description>Returns the set of events valid for this reactor.  Does this
		             by checking each line in the request for it's set of valid events.
		             The result is the set of valid events</description>
		<name>allValidEventsForList</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
			java.util.Set allValidEventsForList(java.lang.String,
				java.util.Collection)
		</function-signature>
	</function>
	<function>
		<description>Returns the set of events valid for this reactor.  Does this
		             by checking each line in the request for its set of valid events.
		             The result is the set of valid events</description>
		<name>allValidEvents</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
			java.util.Set allValidEvents(java.lang.String,
				java.lang.Object)
		</function-signature>
	</function>
	
	<function>
		<description>Returns a string of all valid events for that reactor delimited by |.
		             The context is required in the event that some events specify
		             assignment, so we need current user context</description>
		<name>allEvents</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
			java.lang.String allEvents(java.lang.String,
				java.lang.Object,
				com.scplatform.pcm.authentication.dto.ApplicationContext)
		</function-signature>
	</function>
	<function>
		<description>Returns a string of all valid events for that reactor delimited by |.
		             The context is required in the event that some events specify
		             assignment, so we need current user context</description>
		<name>allEventsForList</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
			java.util.Map allEventsForList(java.lang.String,
				java.util.Collection, 
				com.scplatform.pcm.authentication.dto.ApplicationContext)
		</function-signature>
	</function>

	<function>
		<description>Gets a value from the the configuration</description>
		<name>getConfigValue</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
			java.lang.Object getConfigValue(java.lang.String)
		</function-signature>
	</function>
    
	<function>
		<description>Gets date portion of a full date time</description>
		<name>dateOnly</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
			java.util.Date dateOnly(java.util.Date)
		</function-signature>
	</function>
     
	<function>
		<description>Allows use of PropertyUtils getProperty to emulate the way controller can get to bean properties</description>
		<name>getBeanProperty</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>

		<function-signature>
     	    java.lang.Object getBeanProperty(java.lang.Object, java.lang.String)
		</function-signature>
	</function>
     
    <function>    
         <description>Invoke the transform for this list of object</description>
         <name>transform</name>
         <function-class>com.test.common.util.ObjectTransformer</function-class>
         <function-signature> java.util.List transform(com.test.common.util.ObjectTransformer, java.util.Collection)</function-signature>
         <example> Example invoking transform for each row in a search result set.
                Assumption is the transform was set in the search definition
   				If no transform exists, the result is null
   				&lt;c:forEach var="row" items="${itemSearchForm.searchResult.values}" varStatus="rowCount"&gt;
   				&lt;c:set var="trs" value="${e2ofn:transform(itemSearchForm.sourceTransform,row.values)}"/&gt;
   				&lt;/c:forEach&gt;
         </example>
    </function>
    
    <function>
		<description>Get component version</description>
		<name>getProductVersion</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>

		<function-signature>
     	    java.lang.String getProductVersion()
		</function-signature>
	</function>
	
	<function>
		<description>Get Price Fiscal Data</description>
		<name>getPriceHorizon</name>
		<function-class>
			com.scplatform.pcm.web.PriceTAMHelper
		</function-class>

		<function-signature>
     	    java.util.Map getHorizonPriceData(com.scplatform.pcm.web.action.tam.PriceTAMForm , java.lang.Long , java.lang.String , java.lang.Long , java.lang.String , java.lang.Long , java.lang.Long , java.lang.Long , java.lang.Long , java.lang.Integer)
		</function-signature>
	</function>
	
	<function>
		<description>Get TAM Fiscal Data</description>
		<name>getTAMHorizon</name>
		<function-class>
			com.scplatform.pcm.web.PriceTAMHelper
		</function-class>

		<function-signature>
     	    java.util.Map getHorizonTAMData(com.scplatform.pcm.web.action.tam.PriceTAMForm , java.lang.Long , java.lang.String , java.lang.Long , java.lang.String , java.lang.Long , java.lang.Long , java.lang.Long , java.lang.Long , java.lang.Integer)
		</function-signature>
	</function>
	
	<function>
		<description>Get offset value</description>
		<name>getPriceOffset</name>
		<function-class>
			com.scplatform.pcm.web.PriceTAMHelper
		</function-class>

		<function-signature>
     	    java.lang.Integer getOffsetValue(com.scplatform.pcm.web.action.tam.PriceTAMForm , java.lang.String , java.lang.String , java.lang.String , java.lang.String)
		</function-signature>
	</function>

    <function>
        <description>Validates if user can edit an item based on business entity and fiscal calendar validation settings</description>
        <name>canEditItem</name>
        <function-class>
            com.scplatform.pcm.web.TagFunctionHelper
        </function-class>
        <function-signature>
            boolean canEditItem(com.scplatform.pcm.authentication.dto.ApplicationContext, com.scplatform.pcm.item.entity.Item)
        </function-signature>
    </function>

	<function>
		<description>Get comma-separated item category names</description>
		<name>getItemCategoryNames</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
			java.lang.String getItemCategoryNames(com.scplatform.pcm.item.entity.Item)
		</function-signature>
	</function>

	<function>
		<description>Formats a cost value using HALF_UP rounding (fixes HALF_EVEN in fmt:formatNumber)</description>
		<name>formatCost</name>
		<function-class>
			com.scplatform.pcm.web.TagFunctionHelper
		</function-class>
		<function-signature>
			java.lang.String formatCost(java.lang.Object, java.lang.Object, java.lang.Object)
		</function-signature>
	</function>

</taglib>

