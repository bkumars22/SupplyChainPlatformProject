<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE taglib>
<taglib>
    <tlib-version>1.3</tlib-version>
    <jsp-version>2.0</jsp-version>
    <short-name>html</short-name>
    <uri>http://www.scplatform.local/tags-html</uri>
    <description>
        <![CDATA[
  Legacy html tag declarations. Provides backward compatibility for deprecated JSP tags.
  ]]>
    </description>

    <tag>
        <name>hidden</name>
        <tag-class>com.test.common.web.taglib.html.HiddenTag</tag-class>
        <body-content>empty</body-content>
        <description>
            <![CDATA[
            <p><strong>
            Render A Hidden Field
        </strong></p>

            <p>
                Renders an HTML &lt;input&gt; element of type hidden, populated
                from the specified value or the specified property of the bean
                associated with our current form. This tag is only valid when
                nested inside a form tag body.
            </p>
        ]]>
        </description>
        <attribute>
            <name>property</name>
            <required>true</required>
            <rtexprvalue>true</rtexprvalue>
            <description>
                <![CDATA[
                The name of the form bean property for which this element is rendered.
            ]]>
            </description>
        </attribute>
        <attribute>
            <name>accesskey</name>
            <required>false</required>
            <rtexprvalue>true</rtexprvalue>
            <description>
                <![CDATA[
                The keyboard character used to move focus immediately to this element.
            ]]>
            </description>
        </attribute>
        <attribute>
            <name>alt</name>
            <required>false</required>
            <rtexprvalue>true</rtexprvalue>
            <description>
                <![CDATA[
                The alternate text for this element.
            ]]>
            </description>
        </attribute>
        <attribute>
            <name>altKey</name>
            <required>false</required>
            <rtexprvalue>true</rtexprvalue>
            <description>
                <![CDATA[
                The message resources key of the alternate text for this element.
            ]]>
            </description>
        </attribute>
        <attribute>
            <name>bundle</name>
            <required>false</required>
            <rtexprvalue>true</rtexprvalue>
            <description>
                <![CDATA[
                The servlet context attributes key for the MessageResources instance to use.
                If not specified, defaults to the application resources configured for our action servlet.
            ]]>
            </description>
        </attribute>
        <attribute>
            <name>disabled</name>
            <required>false</required>
            <rtexprvalue>true</rtexprvalue>
            <type>boolean</type>
            <description>
                <![CDATA[
                Set to true if this input field should be disabled.
            ]]>
            </description>
        </attribute>
        <attribute>
            <name>indexed</name>
            <required>false</required>
            <rtexprvalue>true</rtexprvalue>
            <type>boolean</type>
            <description>
                <![CDATA[
                Valid only inside of logic:iterate tag.
                If true then name of the html tag will be rendered as "id[34].propertyName".
                Number in brackets will be generated for every iteration and taken from ancestor logic:iterate tag.
            ]]>
            </description>
        </attribute>
    </tag>

    <tag>
        <name>messages</name>
        <tag-class>com.test.common.web.taglib.html.MessagesTag</tag-class>
        <body-content>JSP</body-content>
        <description>
            <![CDATA[
            <p><strong>
            Render Messages
        </strong></p>

            <p>
                Renders error/success messages from the request attributes.
                Works with logic:messagesPresent tag to conditionally display messages.
            </p>
        ]]>
        </description>
        <attribute>
            <name>id</name>
            <required>true</required>
            <rtexprvalue>false</rtexprvalue>
            <description>
                <![CDATA[
                The variable name to use for each message in the body.
            ]]>
            </description>
        </attribute>
        <attribute>
            <name>name</name>
            <required>false</required>
            <rtexprvalue>true</rtexprvalue>
            <description>
                <![CDATA[
                The request attribute name under which messages are stored.
                Defaults to the error messages key if not specified.
            ]]>
            </description>
        </attribute>
        <attribute>
            <name>message</name>
            <required>false</required>
            <rtexprvalue>true</rtexprvalue>
            <type>boolean</type>
            <description>
                <![CDATA[
                If true, displays success messages. If false (or omitted), displays error messages.
            ]]>
            </description>
        </attribute>
        <attribute>
            <name>property</name>
            <required>false</required>
            <rtexprvalue>true</rtexprvalue>
            <description>
                <![CDATA[
                The property name to filter messages. If not specified, retrieves all messages.
            ]]>
            </description>
        </attribute>
    </tag>

</taglib>