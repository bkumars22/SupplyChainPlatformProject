  <tag>
    <name>footer</name>
    <tagclass>com.i2.tradematrix.webui.taglib.Footer</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>a complex footer for containers</info>
  </tag>

  <tag>
    <name>header</name>
    <tagclass>com.i2.tradematrix.webui.taglib.Header</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>
      A complex header for containers. 
      The align attribute can be used to right or left justify the contents of the complex header inside a container 
      (not applicable to tabbed containers). 
      Default behavior is not specified is right-justified.
    </info>
    <attribute>
        <name>align</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>

