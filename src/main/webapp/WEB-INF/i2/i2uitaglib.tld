    </attribute>
    <attribute>
        <name>src</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>

  <tag>
    <name>popupcell</name>
    <tagclass>com.i2.tradematrix.webui.taglib.PopupCell</tagclass>
    <bodycontent>JSP</bodycontent>
