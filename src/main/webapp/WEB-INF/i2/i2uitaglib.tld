    </attribute>
  </tag>

  <tag>
    <name>treecell</name>
    <tagclass>com.i2.tradematrix.webui.taglib.TreeCell</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>specialized table cell.  holds a tree</info>
