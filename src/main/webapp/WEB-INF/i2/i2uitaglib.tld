  <tag>
    <name>tabform</name>
    <tagclass>com.i2.tradematrix.webui.taglib.Tabform</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>a form for power tabs</info>
    <attribute>
        <name>action</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>method</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>name</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
