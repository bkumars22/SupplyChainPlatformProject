<taglib>
  <tlibversion>1.0</tlibversion>
  <jspversion>2.1</jspversion>
  <shortname>i2uitaglib</shortname>
  <info>taglib for ui web components</info>

  <tag>
    <name>skin</name>
    <tagclass>com.i2.tradematrix.webui.taglib.SkinTag</tagclass>
    <teiclass>com.i2.tradematrix.webui.taglib.SkinTEI</teiclass>
    <bodycontent>empty</bodycontent>
    <info>
      Selects a skin from the plaf skins collections and puts
      it into the PageContext.
    </info>
    <attribute>
       <name>name</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>scope</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>path</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>

  <tag>
    <name>javascript</name>
    <tagclass>com.i2.tradematrix.webui.taglib.JavaScriptLinkTag</tagclass>
    <bodycontent>empty</bodycontent>
    <info>Generates links to javascript files or inlines their contents</info>
    <attribute>
       <name>path</name>
       <required>true</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>version</name>
       <required>false</required>
    </attribute>
    <attribute>
       <name>absolute</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>inline</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
	<attribute>
		<name>cacheProperty</name>
		<required>false</required>
	</attribute>
  </tag>

  <tag>
    <name>stylesheet</name>
    <tagclass>com.i2.tradematrix.webui.taglib.StyleSheetLinkTag</tagclass>
    <bodycontent>empty</bodycontent>
    <info>Generates links to javascript files or inlines their contents</info>
    <attribute>
       <name>path</name>
       <required>true</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>absolute</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>inline</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>default</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>
<!-- remove base tag because it has problems with WebSEAL and affect relative URLs
  <tag>
    <name>base</name>
    <tagclass>com.i2.tradematrix.webui.taglib.BaseTag</tagclass>
    <teiclass>com.i2.tradematrix.webui.taglib.BaseTEI</teiclass>
    <bodycontent>empty</bodycontent>
    <info>
      Generates an HTML base tag.  Default path is the servlet
      context path.  Setting useRequestPath to "yes" will use
      the path of the servlet request in the HTML base tag.
      Explicitly setting the path attribute overrides both the
      default and the servlet path.
    </info>
    <attribute>
       <name>path</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>includeport</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>
-->
  <tag>
    <name>clientcache</name>
    <tagclass>com.i2.tradematrix.webui.taglib.ClientCacheTag</tagclass>
    <bodycontent>empty</bodycontent>
    <info>
      Controls caching of document content on the client. Setting
      enabled="yes" allows caching and enabled="no" disables
      caching. The default is "no".
    </info>
    <attribute>
       <name>enabled</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
       <name>age</name>
       <required>false</required>
       <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>

  <tag>
    <name>doctype</name>
    <tagclass>com.i2.tradematrix.webui.taglib.DocTypeTag</tagclass>
    <bodycontent>empty</bodycontent>
    <info>
      Generates an HTML document type tag.
    </info>
    <attribute>
       <name>type</name>
       <required>false</required>
       <rtexprvalue>false</rtexprvalue>
    </attribute>
  </tag>

  <tag>
    <name>buttonbar</name>
    <tagclass>com.i2.tradematrix.webui.taglib.Buttonbar</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>a container of multiple buttons</info>
    <attribute>
        <name>nopadding</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>aligncontents</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>newrowcount</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>   
  </tag>

  <tag>
    <name>button</name>
    <tagclass>com.i2.tradematrix.webui.taglib.Button</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>a button tag</info>
    <attribute>
        <name>onclick</name>
        <required>true</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>target</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>disabled</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>emphasized</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>small</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>nopadding</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>id</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>hidden</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>htmlonclick</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>

  <tag>
    <name>shell</name>
    <tagclass>com.i2.tradematrix.webui.taglib.Shell</tagclass>
    <bodycontent>JSP</bodycontent>
    <info>the main visual container for application</info>
    <attribute>
        <name>logo</name>
        <required>true</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>frontlogo</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>background</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>username</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>actions</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>onload</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>framed</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>contenturl</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>onresize</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
  </tag>

  <tag>
    <name>preferences</name>
    <tagclass>com.i2.tradematrix.webui.taglib.Preferences</tagclass>
