	<!-- Notification Client Factories -->
	<bean id="E2CC_Planning"
		class="com.test.repository.notifye2cc.batch.spi.pcm.NotificationClientFactory"
		factory-method="createNotificationClient" destroy-method="cleanup">
		<constructor-arg>
			<bean
				class="com.test.repository.notifye2cc.batch.spi.pcm.NotificationClientFactory.E2CCDBClientConfiguration">
				<property name="driverClassName"
					value="#{T(com.test.utility.common.util.ConfigurationUtils).getString('e2cc.db.jdbcdriver','')}" />
				<property name="jdbcUrl"
					value="#{T(com.test.utility.common.util.ConfigurationUtils).getString('e2cc.db.jdbcUrl','')}" />
				<property name="username"
					value="#{T(com.test.utility.common.util.ConfigurationUtils).getString('e2cc.db.username','')}" />
				<property name="password"
					value="#{T(com.test.utility.common.util.ConfigurationUtils).getString('e2cc.db.password','')}" />
			</bean>
		</constructor-arg>
	</bean>

</beans>