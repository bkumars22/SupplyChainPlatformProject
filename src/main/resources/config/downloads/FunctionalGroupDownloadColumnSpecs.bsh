l.add(ODMPartNumber);


//ODM Part Business Name
OGNLColumnSpec ODMPartBusinessName =new OGNLColumnSpec("#fg.ODMPart.businessEntity.businessEntityName","String",
	new String[] {"ODMPartBusinessName","ODM Item Business"});
l.add(ODMPartBusinessName);


return l;

