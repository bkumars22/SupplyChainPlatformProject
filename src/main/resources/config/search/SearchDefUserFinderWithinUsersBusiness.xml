<?xml version="1.0" encoding="UTF-8"?>
<SearchFormDefinition
	name="SearchDefUserFinderWithinUsersBusiness"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="SearchDefSchema.xsd">
	<Source>
  select u.userKey , u.userName, u.userId from Users u
	 </Source>
	<OrderBy fieldName="u.userName" colummName="userName" />
	<SearchParameters>
		<Text name="userName" matchType="LIKE"
			labelKey="popupfinder.UserFinderWithinUsersBusiness.label.uName">
			<Expression>u.businessEntity.id = :ACTIVE_BE_KEY and upper(u.userName) like upper(:userName) </Expression>
		</Text>
	</SearchParameters>
</SearchFormDefinition>