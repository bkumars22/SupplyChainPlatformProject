<?xml version="1.0" encoding="UTF-8"?>
<SearchFormDefinition name="SearchDefTAMHistory" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xsi:noNamespaceSchemaLocation="SearchDefSchema.xsd">
    <Source>	
		select ah from AllocationAuditHistory ah
		left join ah.site site
    </Source>
    
    <ExtractSource extractTemplateConfig="pcm.tam.audit.downloads.config.paths" extractTemplate="TAMAuditDownload">
		select ah from AllocationAuditHistory ah
		left join ah.site site
	</ExtractSource>

	<Filters>
  		 <FilterExpression name="source" type="FIXED">ah.source in ('TAM')</FilterExpression>
  	</Filters>
    <!-- Combining the date and order will force a sort that handles the lack of precision of timestamp -->
   <OrderBy fieldName="ah.datePerformed" colummName="actionDateGE" default="DESC"/>    
   <OrderBy fieldName="ah.bucketStartDate" default="ASC"/>    
   
   
    <SearchParameters>
    	<Date name="actionDateGE" matchType="GE" labelKey="functional.group.audit.actionDateGE">
          <Expression>ah.datePerformed >= :actionDateGE</Expression>
       </Date>
       <Date name="actionDateLE" matchType="LE" labelKey="functional.group.audit.actionDateLE">
          <Expression>ah.datePerformed &lt; :actionDateLE</Expression>
       </Date> 
       <Text name="groupName" matchType="IEXACT" labelKey="tam.audit.groupName" finderName="FunctionalGroupName">
          <Expression>lower(ah.tamAllocation.functionalGroup.name) = lower(:groupName)</Expression>
       </Text>                  
       <Text name="plan" matchType="IEXACT" labelKey="tam.audit.site" finderName="Site">
          <Expression>lower(site.siteDescription) like lower(:plan)</Expression>
       </Text>
    </SearchParameters>
</SearchFormDefinition>