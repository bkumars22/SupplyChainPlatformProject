<?xml version="1.0" encoding="UTF-8"?>
<SearchFormDefinition
	name="SearchDefEnterpriseCostSiteFinder"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="SearchDefSchema.xsd">
	<Source>
	select s.siteKey, s.siteDescription, s.businessEntity.businessEntityName from Site s 
	join s.businessEntity b with b.businessEntityTypeKey =1 
      </Source>
      <Filters>
      <FilterExpression name="siteType" type="FIXED"> s.siteType in ('GLOBAL','REGION','SITE')</FilterExpression>
      </Filters>
	<OrderBy fieldName="s.siteDescription" colummName="siteDescription" default="ASC"/>
	<SearchParameters>
		<Text name="siteDesc" matchType="LIKE"
			labelKey="popupfinder.EnterpriseCostSiteFinder.label.site">
			<Expression> upper(s.siteDescription) like upper(:siteDesc) </Expression>
		</Text>
	</SearchParameters>
</SearchFormDefinition>