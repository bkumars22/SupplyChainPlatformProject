<?xml version="1.0" encoding="UTF-8"?>
<SearchFormDefinition name="SearchDefItemOnly"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="SearchDefSchema.xsd">
	<Source>
		select im, be
        from Item im join im.businessEntity be 
        left outer join im.categories cat
    </Source>
	<ExtractSource
		extractTemplateConfig="pcm.item.downloads.config.paths"
		extractTemplate="ItemDownload"
		extractWriterClass="com.scplatform.pcm.util.item.ItemExtractSSWriter">
    	select im, be
    	from Item im join im.businessEntity be 
        left outer join im.categories cat
    </ExtractSource>

	<!-- Filter expressions are fixed and not used by the critera displayed 
		to users They are used to construct fixed criteria based on if the named 
		parameter is present in the list of parameter values passed to the query 
		execution -->
	<Filters>
		<FilterExpression name="isDeleted" type="FIXED">im.isDeleted != 'Y'</FilterExpression>
		<FilterExpression name="objectKey">im.itemKey in (:objectKey)</FilterExpression>
		<FilterExpression name="itemType" type="FIXED">im.itemType not in ('CFG')</FilterExpression>
		
	</Filters>
	<OrderBy fieldName="im.itemNumber" colummName="itemNumber" />
	<OrderBy fieldName="im.description"
		colummName="itemDescription" />
	<OrderBy fieldName="be.businessEntityName"
		colummName="businessName" />

	<SearchParameters>
		<Text name="itemNumber" matchType="ILIKE"
			labelKey="item.itemNumber" finderName="ItemNumberWithOutCFGType">
			<Expression>lower(im.itemNumber) like lower(:itemNumber)</Expression>
		</Text>
		<Text name="businessName" matchType="ILIKE"
			labelKey="item.businessName" finderName="BusinessName">
			<Expression>lower(be.businessEntityName) like lower(:businessName)</Expression>
		</Text>
		<Text name="itemDescription" matchType="ILIKE"
			labelKey="item.itemDescription">
			<Expression>lower(im.description) like lower(:itemDescription)</Expression>
		</Text>
		<MultiText name="itemNumbers" matchType="IEXACT"
			labelKey="item.multipleItemNumbers" rows="3" popupFinderName="EnterpriseItemFinder">
			<Expression>lower(im.itemNumber) in (:itemNumbers)</Expression>
		</MultiText>
		<List name="itemType" multiSelect="true" labelKey="item.type">
			<Expression>im.itemType in (:itemType)</Expression>
			<ListValue label="item.item" value="I" />
			<ListValue label="item.supplierItem" value="S" />
			<ListValue label="item.mfgItem" value="M" />
			<ListValue label="item.phantomItem" value="PI" />
		</List>
		<List name="topLevel" multiSelect="false" dataType="boolean"
			labelKey="item.isTopLevel">
			<Expression>coalesce(im.isTopLevel,false) = :topLevel</Expression>
			<ListValue label="info.blank" value="" />
			<ListValue label="info.no" value="false" />
 			<ListValue label="info.yes" value="true" />
		</List>
		<Text name="productFamily" matchType="ILIKE"
			labelKey="item.productFamily">
			<Expression>lower(im.productFamily) like lower(:productFamily)</Expression>
		</Text>
		<Text name="itemClassification" matchType="ILIKE"
			labelKey="item.classification">
			<Expression>lower(im.itemClassification) like lower(:itemClassification)</Expression>
		</Text>
		<Text name="platformName" matchType="ILIKE"
			labelKey="item.platform" finderName="PlatformName">
			<Expression>exists (select 1 from im.platforms ip where lower(ip.platformName) like lower(:platformName))</Expression>
		</Text>
		<List name="isAssigned" multiSelect="false"
			labelKey="as.assigned">
			<Expression>case when :owner is null and :user is null and {VALUE} (select 1 from ItemAssignment where item = im) then 1
          when :owner is not null or :user is not null then 1
          else 0
          end = 1
          </Expression>
			<ListValue label="info.all" value="" />
			<ListValue label="info.yes" value="exists" />
			<ListValue label="info.no" value="not exists" />
		</List>
		<List name="owner" multiSelect="false"
			labelKey="as.responsibility"
			initializer="com.scplatform.pcm.searchframework.initializer.ResponsibilityListInitializer"
			initializerData="responsibilityType:['I']">
			<Expression>case when (:isAssigned is null or :isAssigned = 'exists') and exists (select 1 from im.assignments a where lower(a.responsibility) like lower(:owner) and (:user is null or lower(a.userId) like lower(:user))) then 1
		  when :isAssigned = 'not exists' and not exists (select 1 from im.assignments a where lower(a.responsibility) = lower(:owner) and (:user is null or lower(a.userId) like lower(:user))) then 1
		  else 0
		  end = 1
	      </Expression>
			<ListValue label="info.all" value="" />
		</List>
		<List name="regions" multiSelect="true" labelKey="as.region"
			initializer="com.scplatform.pcm.searchframework.initializer.ResponsibilityRegionListInitializer">
			<Expression>exists (select 1 from im.assignments a left join a.regionalResponsibility rs left join rs.site st where st.siteKey in (:regions))</Expression>
		</List>
		<Text name="user" matchType="ILIKE" labelKey="as.user"
			finderName="ItemOwner">
			<Expression>case when :owner is not null then 1
		  when (:isAssigned is null or :isAssigned = 'exists') and exists (select 1 from im.assignments a where lower(a.userId) like lower(:user)) then 1
		  when :isAssigned = 'not exists' and not exists (select 1 from im.assignments a where lower(a.userId) like lower(:user)) then 1
		  else 0
		  end = 1
          </Expression>
		</Text>
		<Text name="categoryName" matchType="ILIKE"
			labelKey="item.categoryName" finderName="ItemCategoryName">
			<Expression>lower(coalesce(cat.categoryName,'N/A')) like lower(:categoryName)</Expression>
		</Text>
		<MultiText name="categoryNames" matchType="IEXACT"
			labelKey="item.multipleCategoryNames" rows="3"
			popupFinderName="ItemCategoryFinder">
			<Expression>lower(coalesce(cat.categoryName,'N/A')) in (:categoryNames)</Expression>
		</MultiText>
		<Text name="dataSource" matchType="ILIKE"
			labelKey="item.dataSource" finderName="dataSource">
			<Expression>lower(im.dataSource) like lower(:dataSource)</Expression>
		</Text>
          <List name="eolType" multiSelect="false" labelKey="item.eol.state" initializer="com.scplatform.pcm.searchframework.initializer.ItemEOLTypeListInitializer">
            <Expression> im.eolType = :eolType
            </Expression>
        </List>
	</SearchParameters>
</SearchFormDefinition>