<?xml version="1.0" encoding="UTF-8"?>
<SearchFormDefinition name="SearchDefItemOnlyFinder" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xsi:noNamespaceSchemaLocation="SearchDefSchema.xsd">
    <Source>
   select im.itemKey, im.itemNumber, im.description, im.businessEntity.businessEntityName from Item im 
    </Source>
    <OrderBy fieldName="im.itemNumber"  colummName="itemNumber" default="ASC"/>
    <SearchParameters>
       <Text name="itemNumber" matchType="LIKE" labelKey="label.find" >
          <Expression> upper(im.itemNumber) like upper(:itemNumber)</Expression>
       </Text>
    </SearchParameters>
</SearchFormDefinition>