<SearchFormDefinition name="SearchDefBom" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="SearchDefSchema.xsd">
    <Source>
       select b, im from Bom b join b.item im 
       left outer join im.categories cat
       left outer join im.businessEntity be
    </Source>
    <!-- Filter expressions are fixed and not used by the critera displayed to users
         They are used to construct fixed criteria based on if the named parameter
         is present in the list of parameter values passed to the query execution -->
    <ExtractSource extractWriterClass="com.scplatform.pcm.web.action.mdm.BomSearchExtractSSWriter">
        select b, im from Bom b join b.item im
        left outer join im.categories cat
        left outer join im.businessEntity be
    </ExtractSource>
    <Filters>
      <FilterExpression name="isDeleted" type="FIXED">b.isDeleted != 'Y'</FilterExpression>            
<!--  <FilterExpression name="isDeleted" type="FIXED">b.status != 'CLOSED'</FilterExpression> -->
    </Filters>
    <OrderBy fieldName="im.itemNumber" colummName="itemNumber"/>    
    <SearchParameters>
       <Text name="itemNumber" matchType="ILIKE" labelKey="item.itemNumber" finderName="ItemNumber">
          <Expression>lower(im.itemNumber) like lower(:itemNumber)</Expression>
       </Text>
       <Text name="businessName" matchType="ILIKE" labelKey="item.businessName" finderName="BusinessName">
          <Expression>lower(b.businessEntity.businessEntityName) like lower(:businessName)</Expression>
       </Text>     
       <Text name="platform" matchType="ILIKE" labelKey="item.platform" finderName="PlatformName">
			<Expression>exists (select 1 from im.platforms p where lower(p.platformName) like lower(:platform))</Expression> 
       </Text>          
       <MultiText name="itemNumbers" matchType="IEXACT" labelKey="item.multipleItemNumbers" rows="3" popupFinderName="EnterpriseItemFinder">
          <Expression>lower(im.itemNumber) in (:itemNumbers)</Expression>
       </MultiText>                     
       <List name="status" multiSelect="true" labelKey="label.status"
          initializer="com.scplatform.pcm.searchframework.initializer.SMStateInitializer"
          initializerData="BOM">
          <Expression>b.status in (:status)</Expression>
       </List>
       <Text name="revisionNumber" matchType="EXACT" labelKey="bom.revisionNumber">
          <Expression>im.itemVersion.revision like :revisionNumber</Expression>
       </Text>       
       
       <List name="topLevel" multiSelect="false" dataType="boolean" labelKey="item.isTopLevel">
          <Expression>coalesce(im.isTopLevel,0) = :topLevel</Expression>
          <ListValue label=" " value=""/>          
          <ListValue label="info.yes" value="true"/>          
          <ListValue label="info.no" value="false"/>                              
       </List>         
       <List name="subassembly" multiSelect="false" labelKey="bom.subassembly">
          <Expression>{VALUE} (select bl.id from BomLine bl where bl.item = im)</Expression>
          <ListValue label=" " value=""/>          
          <ListValue label="info.yes" value="exists"/>          
          <ListValue label="info.no" value="not exists"/>                              
       </List>          
                    
       <Text name="versionNumber" matchType="LIKE" labelKey="bom.versionNumber">
          <Expression>b.bomVersion.version like :versionNumber</Expression>
       </Text>
       <List name="isAssigned" multiSelect="false" labelKey="as.assigned">
          <Expression>case when :owner is null and :user is null and {VALUE} (select 1 from ItemAssignment where item = im) then 1
          when :owner is not null or :user is not null then 1
          else 0
          end = 1
          </Expression>
          <ListValue label="info.all" value=""/>       
          <ListValue label="info.yes" value="exists"/>          
          <ListValue label="info.no" value="not exists"/>
       </List>
       <List name="owner" multiSelect="false" labelKey="as.responsibility"
          initializer="com.scplatform.pcm.searchframework.initializer.ResponsibilityListInitializer"
          initializerData="responsibilityType:['I']">
		  <Expression>case when (:isAssigned is null or :isAssigned = 'exists') and exists (select 1 from im.assignments a where lower(a.responsibility) like lower(:owner) and (:user is null or lower(a.userId) like lower(:user))) then 1
		  when :isAssigned = 'not exists' and not exists (select 1 from im.assignments a where lower(a.responsibility) = lower(:owner) and (:user is null or lower(a.userId) like lower(:user))) then 1
		  else 0
		  end = 1
	      </Expression>
          <ListValue label="info.all" value=""/>
       </List>
	   <List name="regions" multiSelect="true" labelKey="as.region"
          initializer="com.scplatform.pcm.searchframework.initializer.ResponsibilityRegionListInitializer">
          <Expression>exists (select 1 from im.assignments a left join a.regionalResponsibility rs left join rs.site st where st.siteKey in (:regions))</Expression>
       </List>
       <Text name="user" matchType="ILIKE" labelKey="as.user" finderName="ItemOwner">
          <Expression>case when :owner is not null then 1
		  when (:isAssigned is null or :isAssigned = 'exists') and exists (select 1 from im.assignments a where lower(a.userId) like lower(:user)) then 1
		  when :isAssigned = 'not exists' and not exists (select 1 from im.assignments a where lower(a.userId) like lower(:user)) then 1
		  else 0
		  end = 1
          </Expression>
       </Text>
       <Text name="description" matchType="ILIKE" labelKey="bom.description">
          <Expression>lower(coalesce(b.description,im.description)) like lower(:description)</Expression>
       </Text>
       <List name="isRepairs" multiSelect="false" dataType="boolean" labelKey="bom.isRepairs">
          <Expression>coalesce(b.isRepairs,0) = :isRepairs</Expression>
          <ListValue label=" " value=""/>          
          <ListValue label="info.yes" value="true"/>          
          <ListValue label="info.no" value="false"/>                              
       </List>
       <List name="contextType" multiSelect="no" labelKey="bom.contextType" checkIfTrue="pcm.bom.incontext">
          <ListValue label="info.all" value=""/>       
          <ListValue label="bom.contextType.business" value="BUSINESS"/>          
          <Expression>lower(b.bomContext.contextType) like lower(:contextType)</Expression>
       </List>
       <Text name="contextId" matchType="LIKE" labelKey="bom.contextName" checkIfTrue="pcm.bom.incontext">
          <Expression>lower(b.contextIdentifier) like lower(:contextId)</Expression>
       </Text>
       <Date name="effectiveFrom" labelKey="bom.effectiveFrom" matchType="GT">
          <Expression>(b.effectiveFrom is null or trunc(b.effectiveFrom) >= trunc(:effectiveFrom))</Expression>
       </Date>
       <Date name="effectiveTo" labelKey="bom.effectiveTo" matchType="LT">
          <Expression>(trunc(b.effectiveTo) &lt;= trunc(:effectiveTo))</Expression>
       </Date>
       <Text name="dataSource" matchType="ILIKE" labelKey="item.dataSource" finderName="dataSource">
          <Expression>lower(im.dataSource) like lower(:dataSource)</Expression>
       </Text>
    </SearchParameters>
</SearchFormDefinition>