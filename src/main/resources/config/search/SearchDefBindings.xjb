<?xml version="1.0" encoding="UTF-8"?>
<jxb:bindings version="1.0" xmlns:jxb="http://java.sun.com/xml/ns/jaxb"
	xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<jxb:bindings schemaLocation="SearchDefSchema.xsd">
		<jxb:bindings node="/xs:schema//xs:complexType[@name='SearchFormDefinitionType']">
			<jxb:class name="SearchDefinitionType" />
		</jxb:bindings>
		<jxb:bindings node="/xs:schema//xs:complexType[@name='SearchParametersType']//xs:choice">
			<jxb:property name="searchParameters" />
		</jxb:bindings>
		<jxb:bindings node="/xs:schema//xs:complexType[@name='SearchParameterType']//xs:element[@name='Property']">
			<jxb:property name="properties" />
		</jxb:bindings>
		<jxb:bindings node="/xs:schema//xs:complexType[@name='ListType']//xs:element[@name='ListValue']">
			<jxb:property name="listValues" />
		</jxb:bindings>
	</jxb:bindings>
</jxb:bindings>