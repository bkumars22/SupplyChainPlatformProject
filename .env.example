# Supply Chain Intelligence Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Railway / Production Database ─────────────────────────────────────────────
# Railway provides this automatically. Format: postgresql://user:pass@host:port/db
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Local Docker Compose Database ─────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_local

# ── Spring Boot (prod profile) ────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/scip
SPRING_DATASOURCE_USERNAME=scip
SPRING_DATASOURCE_PASSWORD=change_me

# ── JWT Authentication ─────────────────────────────────────────────────────────
# Must be at least 64 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_random_secret_generated_by_openssl_rand_hex_32

# ── Anthropic Claude AI ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── SCIP Agent credentials (ai-service only) ──────────────────────────────────
SCIP_USERNAME=kumar
SCIP_PASSWORD=change_me

# ── CORS / URLs ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
AI_SERVICE_URL=http://localhost:8001

# ── Optional ──────────────────────────────────────────────────────────────────
HTTPS_REDIRECT=false
SWAGGER_ENABLED=true
